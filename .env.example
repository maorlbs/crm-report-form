# --- Server (Node backend) — never sent to the browser ---------------------
# monday.com API token — Avatar menu > Admin > API, or your personal API token page
MONDAY_API_TOKEN=

# Random secret shared with whatever triggers /webhook/lesson-report (e.g. the
# Make.com HTTP module) - generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# The frontend's origin - the backend only accepts browser requests from here
ALLOWED_ORIGIN=http://localhost:5183

WEBHOOK_PORT=3001

# Comma-separated emails that get admin access (view all teachers, reset
# passwords, sign hours on behalf of a teacher) instead of a regular teacher account
ADMIN_EMAILS=
# Display names, same order as ADMIN_EMAILS (comma-separated)
ADMIN_NAMES=

# --- Frontend (Vite) — public, ships in the browser bundle ------------------
# Just the backend's URL, not a secret
VITE_API_BASE_URL=http://localhost:3001
